<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/info_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:padding="4dp">

    <!-- ═══ Hero Section (three columns) ═══ -->
    <LinearLayout
        android:id="@+id/hero_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left column: APS Mode -->
        <LinearLayout
            android:id="@+id/aps_mode_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APS MODE"
                android:textSize="10sp"
                android:textColor="#9aa0ad"
                android:letterSpacing="0.1"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/aps_mode"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                app:srcCompat="@drawable/ic_loop_closed"
                android:contentDescription="@string/aps_mode_title" />

            <TextView
                android:id="@+id/aps_mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Open Loop"
                android:textColor="#e8eaf0"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Centre column: BG Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/bg_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/a11y_bg_quality" />

                <TextView
                    android:id="@+id/bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    tools:text="150"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/delta_large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#aaaaaa"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="(+1.0)"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- Arrows and time ago -->
            <LinearLayout
                android:id="@+id/arrows_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="-8dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/trend_arrow" />

                <TextView
                    android:id="@+id/time_ago"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#aaaaaa"
                    android:textSize="14sp"
                    tools:text="3m ago"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- Deltas (mini table) -->
            <TableLayout
                android:id="@+id/deltas_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TableRow android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        tools:text="Δ: +1.2"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:id="@+id/avg_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        tools:text="Δ15: +1.0"
                        tools:ignore="HardcodedText" />
                </TableRow>
                <TableRow android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/bgAcceleration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        tools:text="acc: 0.1"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:id="@+id/long_avg_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        tools:text="Δ40: +0.8"
                        tools:ignore="HardcodedText" />
                </TableRow>
            </TableLayout>

        </LinearLayout>

        <!-- Right column: Reading Time -->
        <LinearLayout
            android:id="@+id/time_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textSize="10sp"
                android:textColor="#9aa0ad"
                android:letterSpacing="0.1"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#e8eaf0"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="8:00 PM"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/time_ago_short"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#aaaaaa"
                android:textSize="14sp"
                tools:text="(-5)"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Stat Pills Row (4 columns) ═══ -->
    <LinearLayout
        android:id="@+id/pills_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/hero_section"
        android:baselineAligned="false">

        <!-- IOB pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/iob_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IOB"
                    android:textSize="10sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/iob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#60a5fa"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="3.21u"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sensitivity pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/as_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENS"
                    android:textSize="10sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/sensitivity_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:srcCompat="@drawable/ic_swap_vert_black_48dp_green"
                        android:contentDescription="@string/a11y_autosens_label" />

                    <TextView
                        android:id="@+id/sensitivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#c084fc"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="100%"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/variable_sensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#c084fc"
                    android:textSize="11sp"
                    tools:text="110%"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Basal pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/basal_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BASAL"
                    android:textSize="10sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/base_basal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#fb923c"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="0.50u"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/base_basal_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:srcCompat="@drawable/ic_cp_basal_no_tbr"
                    android:contentDescription="@string/basal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Extended pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/extended_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXT"
                    android:textSize="10sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/extended_bolus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00d4ff"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="0.00u"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Hidden / Removed Carbs Layout to keep it functional -->
    <LinearLayout
        android:id="@+id/cob_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/carbs_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/cob" />
        <TextView android:id="@+id/cob" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
