<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/info_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- ═══ Hero Section (three columns) ═══ -->
    <LinearLayout
        android:id="@+id/hero_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left column: Pump info -->
        <LinearLayout
            android:id="@+id/pump_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUMP"
                android:textSize="11sp"
                android:textColor="#9aa0ad"
                android:letterSpacing="0.1"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/reservoir_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#e8eaf0"
                tools:text="87U" />

            <!-- battery -->
            <LinearLayout
                android:id="@+id/battery_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_cp_age_battery"
                    app:tint="#ffffff"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/pb_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#aaaaaa"
                    android:layout_marginStart="4dp"
                    tools:text="72%" />
            </LinearLayout>

            <!-- cannula age -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/cannula_or_patch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_cp_age_cannula"
                    app:tint="#ffffff"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/cannula_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#aaaaaa"
                    android:layout_marginStart="4dp"
                    tools:text="1d 4h" />
            </LinearLayout>

            <!-- sensor age -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/sensor_age_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_cp_age_sensor"
                    app:tint="#ffffff"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/sensor_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#aaaaaa"
                    android:layout_marginStart="4dp"
                    tools:text="4d 2h" />
            </LinearLayout>
        </LinearLayout>

        <!-- Centre column: BG -->
        <LinearLayout
            android:id="@+id/center_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/aps_mode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    app:srcCompat="@drawable/ic_loop_closed"
                    android:contentDescription="@string/aps_mode_title" />

                <TextView
                    android:id="@+id/bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    tools:text="150"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/arrows_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="-16dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/arrow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/trend_arrow" />

                <TextView
                    android:id="@+id/delta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="#aaaaaa"
                    android:layout_marginStart="6dp"
                    tools:text="-0.8 Falling"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/aps_mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="4dp"
                tools:text="Closed Loop"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/delta_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right column: Reading age, Target, Profile -->
        <LinearLayout
            android:id="@+id/time_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READING"
                android:textSize="11sp"
                android:textColor="#9aa0ad"
                android:letterSpacing="0.1"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#e8eaf0"
                tools:text="3m ago" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET"
                android:textSize="11sp"
                android:textColor="#9aa0ad"
                android:letterSpacing="0.1"
                android:layout_marginTop="12dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/temp_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#e8eaf0"
                tools:text="5.5" />

            <TextView
                android:id="@+id/active_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="6dp"
                tools:text="Normal" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Stat Pills Row (3 columns) ═══ -->
    <LinearLayout
        android:id="@+id/pills_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/hero_section"
        android:baselineAligned="false">

        <!-- IOB pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/iob_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IOB"
                    android:textSize="11sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/iob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#60a5fa"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"
                    tools:text="3.21u" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SENS pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/as_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENS"
                    android:textSize="11sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#c084fc"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"
                    tools:text="100%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BASAL pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:cardBackgroundColor="#10121a"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#1a1d28"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/basal_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BASAL"
                    android:textSize="11sp"
                    android:textColor="#9aa0ad"
                    android:letterSpacing="0.1"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/base_basal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#fb923c"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"
                    tools:text="0.50u" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Hidden elements for compatibility -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/time_ago_short" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/avg_delta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/bgAcceleration" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/long_avg_delta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/cob" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/extended_bolus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/variable_sensitivity" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/active_profile_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/sensitivity_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/base_basal_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bg_quality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/carbs_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
        <TextView android:id="@+id/pb_age" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/insulin_age" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/profile_pill_card" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/profile_pill_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/extended_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" />
        <TableLayout android:id="@+id/deltas_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/cob_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
